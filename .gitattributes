# Normalise line endings.
#
# The team works across Windows and Linux (and the backend deploys to Linux on
# Render), so text files are stored with LF in the repository and checked out
# with whatever the local platform uses. Without this, a Windows commit flips
# every line of every file and diffs become unreadable.
* text=auto eol=lf

# Explicit, so these never get mangled regardless of local config.
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Shell scripts must keep LF or they will not run on Linux.
*.sh    text eol=lf

# Binary files: never touch.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.pdf   binary

# Collapse lockfile noise in pull-request diffs.
package-lock.json linguist-generated=true -diff
