# ---------------------------------------------------------------------------
# Sentinel API — environment configuration
# Copy to `.env` and fill in real values. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
# Leave PORT unset on Render — it injects one and the app reads it.
PORT=5000

# MongoDB Atlas connection string.
# Atlas: Database > Connect > Drivers. URL-encode a password containing special
# characters (@ becomes %40), and add 0.0.0.0/0 to Atlas Network Access —
# Render does not publish stable egress IPs on its lower tiers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sentinel?retryWrites=true&w=majority

# JWT signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every token, so patients must sign in again — which
# means someone has to physically pick up their phone. Rotate deliberately.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API.
# Exact origins: scheme included, no trailing slash, no path. localhost and
# 127.0.0.1 are different origins, so list both in development.
# Any https://<name>.vercel.app is allowed automatically for branch previews.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------------------------- tracking behaviour ----------------------------

# How often the patient's phone uploads a fix. Must match the client's
# LOCATION_INTERVAL_MS in frontend/src/lib/constants.ts.
LOCATION_INTERVAL_MS=180000

# Silence longer than this marks a patient offline and raises an alert.
# A little over two upload cycles: one missed upload is routine (a tunnel, a
# lift, a slow fix) and alerting on it trains the caretaker to ignore the alert.
OFFLINE_THRESHOLD_MS=420000

# How often the server sweeps for newly-offline patients. This bounds how late
# an offline alert can be, not how soon it can fire.
PRESENCE_SWEEP_MS=60000

# Battery percentage at or below which a low-battery alert is raised.
LOW_BATTERY_THRESHOLD=20

# Fixes with accuracy worse than this (metres) are treated as unreliable.
POOR_ACCURACY_THRESHOLD_M=150

# Minimum gap between two identical alerts for one patient, in ms.
# Transition detection in the geofence engine is the primary defence against
# repeats; this is the backstop for everything else. SOS is always exempt.
ALERT_COOLDOWN_MS=120000

# ------------------------------ rate limiting ------------------------------

RATE_LIMIT_WINDOW_MS=900000

# General budget per IP per window. Several caretakers behind one NAT share an
# IP, and each dashboard refetches aggregates on socket events.
RATE_LIMIT_MAX=2000

# Failed sign-in attempts per IP per window. Successful logins do not count.
AUTH_RATE_LIMIT_MAX=20

# Proxy hops to trust for client IPs. Render terminates TLS at a proxy, so this
# must be right or rate limiting keys on the proxy's address instead of the
# client's.
TRUST_PROXY=1

# Log verbosity: error | warn | info | debug
# debug is what shows cooldown suppressions, socket joins and presence sweeps.
LOG_LEVEL=debug
