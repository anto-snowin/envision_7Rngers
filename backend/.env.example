# ---------------------------------------------------------------------------
# Dementia Care Monitoring API - environment configuration
# Copy to `.env` and fill in real values. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string.
# Atlas: Database > Connect > Drivers. Remember to URL-encode a password that
# contains special characters, and add your IP (or 0.0.0.0/0 for Render) to the
# Atlas Network Access list.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dementia-care?retryWrites=true&w=majority

# JWT signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API.
# Include your Vercel production domain once deployed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------- tracking behaviour ----------------------------

# How often the patient's phone sends a fix (echoed to the client).
LOCATION_INTERVAL_MS=5000

# Silence longer than this marks a patient offline and raises an alert.
OFFLINE_THRESHOLD_MS=30000

# How often the server sweeps for newly-offline patients.
PRESENCE_SWEEP_MS=15000

# Battery percentage at or below which a low-battery alert is raised.
LOW_BATTERY_THRESHOLD=20

# Fixes with accuracy worse than this (metres) are treated as unreliable.
POOR_ACCURACY_THRESHOLD_M=150

# Minimum gap between two identical alerts for one patient, in ms.
# Stops a patient parked just outside their safe zone from alerting every 5 s.
ALERT_COOLDOWN_MS=120000

# ------------------------------ rate limiting ------------------------------

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# Proxy hops to trust for client IPs. Render terminates TLS at a proxy, so
# this must be set for rate limiting to key on the real client address.
TRUST_PROXY=1

# Log verbosity: error | warn | info | debug
LOG_LEVEL=debug
