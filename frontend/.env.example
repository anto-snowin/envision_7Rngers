# ---------------------------------------------------------------------------
# Frontend environment configuration
# Copy to `.env` and adjust. Vite only exposes variables prefixed with VITE_.
# ---------------------------------------------------------------------------

# Base URL of the backend API (no trailing slash, no /api suffix).
# The axios client appends /api, and Socket.IO connects to this origin.
#
#   local development : http://localhost:5000
#   production        : https://your-service.onrender.com
VITE_API_URL=http://localhost:5000
