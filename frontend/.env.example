# ---------------------------------------------------------------------------
# Sentinel — web client environment
#
# Copy to `.env.local` for local development. Only variables prefixed with
# NEXT_PUBLIC_ are readable in the browser, which is exactly what is needed
# here: the client talks to the API and the socket directly, and holds no
# secrets of its own.
# ---------------------------------------------------------------------------

# Base URL of the Express API and Socket.IO server, with no trailing slash.
# Local:      http://localhost:5000
# Production: https://your-service.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000
